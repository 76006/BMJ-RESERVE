.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 999;
  box-sizing: border-box;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  gap: 4rpx;
}
.tab-icon {
  font-size: 36rpx;
  color: var(--mid-gray);
  line-height: 1;
  transition: color 0.2s;
}
.tab-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mid-gray);
  line-height: 1.2;
  transition: color 0.2s;
}
.tab-bar-item.active .tab-icon,
.tab-bar-item.active .tab-text {
  color: var(--brand-blue);
}
