/* ===== 顾客签到页 ===== */
.page {
  padding-bottom: max(32rpx, env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

.g-step {
  padding: 0 0 30rpx;
}

.g-step.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 20rpx;
  text-align: center;
}

/* ===== 加载 ===== */
.loading-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.loading-text { font-size: 30rpx; color: var(--text-muted); }

/* ===== 未找到预约 ===== */
.nf-wrap {
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nf-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.nf-title { font-size: 34rpx; font-weight: 500; color: var(--text-primary); margin-bottom: 16rpx; text-align: center; }
.nf-desc { font-size: 28rpx; color: var(--mid-gray); line-height: 1.6; margin-bottom: 32rpx; padding: 0 20rpx; text-align: center; }
.auth-phone-btn { width: calc(100% - 60rpx); margin-bottom: 4rpx; }

/* 手动选择今日预约列表 */
.nf-list {
  width: 100%;
  margin-bottom: 32rpx;
}
.nf-list-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}
.nf-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}
.nf-item:active { background: var(--gray-100); }
.nf-item-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.nf-item-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
}
.nf-item-time {
  font-size: 26rpx;
  color: var(--text-muted);
}
.nf-item-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.nf-item-status {
  font-size: 24rpx;
  color: var(--brand-blue);
  background: #EEF3FB;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}
.nf-item-arrow {
  font-size: 40rpx;
  color: var(--gray-300);
  line-height: 1;
}

/* ===== 确认预约 ===== */
.gs-header {
  text-align: center;
  padding: 30rpx 30rpx 30rpx;
}
.gs-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.gs-title { display: block; font-size: 38rpx; font-weight: 500; color: var(--text-primary); margin-bottom: 12rpx; }
.gs-sub { display: block; font-size: 28rpx; color: var(--mid-gray); }

.booking-card {
  margin: 0 30rpx 24rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-shadow: var(--shadow-sm);
}
.bc-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
}
.bc-row:last-child { border-bottom: none; }
.bc-label { font-size: 26rpx; color: var(--mid-gray); width: 140rpx; flex-shrink: 0; }
.bc-value { font-size: 28rpx; color: var(--text-secondary); flex: 1; }

.confirm-notice {
  margin: 0 30rpx 30rpx;
  background: #EEF6EE;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.notice-text { font-size: 26rpx; color: #3A8A3A; line-height: 1.6; }

/* ===== 主按钮 ===== */
.g-btn-primary {
  display: block;
  margin: 0 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--brand-blue);
  color: #FFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  border: none;
  padding: 0;
}
.g-btn-primary::after { border: none; }
.g-btn-primary.disabled { background: var(--gray-300); }

.g-btn-secondary {
  display: block;
  margin: 32rpx 30rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: var(--brand-blue);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid var(--brand-blue);
  padding: 0;
}
.g-btn-secondary::after { border: none; }

.btn-proceed {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  white-space: nowrap;
  font-size: 30rpx;
}

.consent-top {
  background: var(--brand-blue);
  padding: 30rpx 30rpx 36rpx;
  text-align: center;
}
.ct-title { font-size: 36rpx; font-weight: 600; color: #FFF; margin-bottom: 8rpx; }
.ct-sub { font-size: 26rpx; color: rgba(255,255,255,0.75); }

/* ===== 平铺内容区 ===== */
.consent-scroll.flat { padding: 0 30rpx 30rpx; height: calc(100vh - 360rpx); }
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin: 36rpx 0 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--gray-100);
}
.section:first-child .section-title { margin-top: 10rpx; }

/* 引言 */
.sec-intro {
  padding: 30rpx 0 20rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

/* 章节 */
.section {
  border-bottom: 1rpx solid var(--gray-100);
}

/* 文本 */
.p-text { font-size: 26rpx; color: var(--text-muted); line-height: 1.8; display: block; }

/* 基本信息 */
.info-row { display: flex; align-items: center; padding: 8rpx 0; }
.info-label { font-size: 26rpx; color: var(--text-muted); }
.info-gap { width: 60rpx; flex-shrink: 0; }
.info-em { color: var(--text-secondary); font-weight: 500; }
.info-sep { height: 1rpx; background: var(--gray-100); margin: 12rpx 0; }

/* 风险列表 */
.risk-list { margin-top: 12rpx; }
.risk-item { display: block; font-size: 26rpx; color: var(--text-muted); line-height: 1.8; }
.risk-note { margin-top: 16rpx; font-weight: 500; }

/* 不建议体验的情况 */
.contra-group { margin-bottom: 20rpx; }
.contra-label {
  display: block;
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
  margin-bottom: 8rpx;
  margin-top: 4rpx;
}
.contra-item { display: block; font-size: 24rpx; color: var(--text-muted); line-height: 1.8; }
.contra-judge { margin-top: 16rpx; font-weight: 500; }

/* 权利义务 / 免责声明 / 撤回 */
.num-list { }
.num-item { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.num { font-size: 26rpx; color: #6B7280; font-weight: 600; flex-shrink: 0; }
.num-text { font-size: 26rpx; color: var(--text-muted); line-height: 1.8; flex: 1; }

/* 摄影授权 */
.photo-auth {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
}
.photo-auth-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}
.photo-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.photo-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 6rpx;
  border: 2rpx solid var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #FFF;
  font-size: 24rpx;
  color: #FFF;
}
.photo-check.checked {
  background: var(--brand-blue);
  border-color: var(--brand-blue);
}
.photo-text { font-size: 26rpx; color: var(--text-muted); line-height: 1.6; flex: 1; }
.photo-note {
  font-size: 24rpx;
  color: var(--mid-gray);
  display: block;
  margin-top: 8rpx;
}

/* 签署行 */
.sign-line {
  padding: 20rpx 0 20rpx;
}
.sign-text { font-size: 26rpx; color: var(--text-muted); }

/* 下滑提示 */
.scroll-hint {
  background: var(--bg);
  text-align: center;
  padding: 14rpx;
}
.scroll-hint-text { font-size: 24rpx; color: var(--text-muted); }

/* 勾选 */
.all-read {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #FFF;
  gap: 16rpx;
}
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #FFF;
  font-size: 26rpx;
  color: #FFF;
}
.checkbox.checked {
  background: var(--brand-blue);
  border-color: var(--brand-blue);
}
.all-read-text { font-size: 26rpx; color: var(--text-muted); flex: 1; line-height: 1.5; }

.btn-sign {
  margin-top: 0;
  border-radius: 16rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* ===== 完成页 ===== */
.done-card {
  background: #FFF;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  margin: 0 40rpx 32rpx;
  box-shadow: var(--shadow-sm);
  text-align: center;
  width: calc(100% - 80rpx);
  box-sizing: border-box;
}

.done-check-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.check-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand-blue);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-circle.error {
  background: #DC2626;
}

.check-mark {
  font-size: 60rpx;
  color: #FFF;
  font-weight: 700;
  line-height: 1;
}

.done-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.done-sub {
  font-size: 28rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 4rpx;
}

.done-info {
  margin-top: 24rpx;
  padding: 16rpx 28rpx;
  background: var(--gray-100);
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
}

.done-info-date {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.done-info-sep {
  font-size: 26rpx;
  color: var(--text-light);
  margin: 0 8rpx;
}

.done-info-time {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.done-welcome {
  font-size: 28rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 32rpx;
  padding: 0 40rpx;
  text-align: center;
}

/* ===== 体验确认弹窗 ===== */
.experience-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  width: 560rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.modal-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.modal-mini-check {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-blue);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-check-mark {
  font-size: 48rpx;
  color: #FFF;
  font-weight: 700;
  line-height: 1;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.modal-body {
  margin-bottom: 40rpx;
}

.modal-text {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
}

.modal-btn::after { border: none; }

.modal-btn.secondary {
  background: var(--gray-100);
  color: var(--text-muted);
}

.modal-btn.primary {
  background: var(--brand-blue);
  color: #FFFFFF;
}
