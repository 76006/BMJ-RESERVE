.page {
  padding: 32rpx 32rpx max(64rpx, calc(32rpx + env(safe-area-inset-bottom))); min-height: 100vh; background: var(--bg); }

.preview-banner {
  background: var(--brand-blue);
  color: #fff;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.header {
  text-align: center;
  padding: 20rpx 0 32rpx;
}
.header-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  margin-bottom: 16rpx;
}
.header-title { font-size: 36rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 8rpx; }
.header-desc { font-size: 24rpx; color: var(--mid-gray); }

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--gray-100);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

/* 满意度列表 */
.satisfaction-list { display: flex; flex-direction: column; gap: 16rpx; }
.satisfy-item { display: flex; align-items: center; justify-content: space-between; }
.area-name { font-size: 26rpx; color: var(--text-secondary); }
.stars { display: flex; gap: 8rpx; }
.star { font-size: 40rpx; color: var(--gray-200); transition: color .2s; }
.star.active { color: var(--amber); }

/* 照片 */
.photo-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.photo-item { position: relative; width: 200rpx; height: 200rpx; border-radius: 12rpx; overflow: hidden; }
.photo-preview { width: 100%; height: 100%; }
.photo-del {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 40rpx; height: 40rpx; background: rgba(0,0,0,.5);
  color: #fff; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 28rpx;
}
.photo-add {
  width: 200rpx; height: 200rpx; border: 1rpx dashed var(--gray-300);
  border-radius: 12rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; background: var(--gray-50);
}
.add-icon { font-size: 48rpx; color: var(--mid-gray); line-height: 1; }
.add-text { font-size: 24rpx; color: var(--mid-gray); margin-top: 8rpx; }
.photo-hint { font-size: 24rpx; color: var(--mid-gray); margin-top: 12rpx; }

.feedback-textarea {
  width: 100%; height: 160rpx; background: var(--gray-50);
  border: 1rpx solid var(--gray-200); border-radius: 10rpx;
  padding: 16rpx; font-size: 26rpx; box-sizing: border-box;
}

/* 意愿选择 */
.retry-toggle { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.retry-opt {
  flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  border: 1rpx solid var(--gray-200); border-radius: 12rpx;
  font-size: 26rpx; color: var(--text-muted);
}
.retry-opt.active {
  background: var(--brand-blue); color: #fff; border-color: var(--brand-blue);
}

.submit-bar { padding: 16rpx 0 32rpx; }
.btn-submit {
  width: 100%; height: 88rpx; line-height: 88rpx;
  text-align: center; background: var(--brand-blue); color: #fff;
  border-radius: 14rpx; font-size: 30rpx; font-weight: 500;
}

.bottom-safe { height: calc(40rpx + env(safe-area-inset-bottom)); }
