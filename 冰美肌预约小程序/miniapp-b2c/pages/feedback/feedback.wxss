.page { padding: 32rpx 32rpx max(64rpx, calc(32rpx + env(safe-area-inset-bottom))); min-height: 100vh; background: var(--bg); }
.loading { padding: 120rpx 0; text-align: center; color: var(--mid-gray); font-size: 28rpx; }
.preview-banner { background: var(--brand-blue); color: #fff; text-align: center; padding: 16rpx; font-size: 26rpx; border-radius: 8rpx; margin-bottom: 16rpx; }
.header { text-align: center; padding: 20rpx 0 32rpx; }
.header-badge { display: inline-flex; align-items: center; justify-content: center; background: #F3F4F6; color: #6B7280; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: var(--radius-full); margin-bottom: 16rpx; }
.header-title { font-size: 36rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 8rpx; }
.header-desc { font-size: 24rpx; color: var(--mid-gray); }
.submitted { margin: 16rpx auto 0; padding: 12rpx 18rpx; border-radius: 10rpx; background: #ECFDF5; color: #047857; font-size: 22rpx; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx 28rpx 32rpx; margin-bottom: 24rpx; border: 1rpx solid var(--gray-100); }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--gray-100); }
.satisfaction-list { display: flex; flex-direction: column; gap: 20rpx; }
.satisfy-item { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.area-name { flex: 1; font-size: 25rpx; color: var(--text-secondary); }
.stars { display: flex; gap: 5rpx; }
.star { padding: 3rpx; font-size: 38rpx; color: var(--gray-200); }
.star.active { color: var(--amber); }
.photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.photo-card { padding: 14rpx; border-radius: 14rpx; background: #F9FAFB; }
.angle-label { display: block; margin-bottom: 10rpx; text-align: center; font-size: 23rpx; color: #374151; font-weight: 600; }
.photo-box { position: relative; width: 100%; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 12rpx; background: #F3F4F6; }
.photo-box.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx dashed #C4B5FD; background: #FAF8FF; }
.photo-image { width: 100%; height: 100%; }
.plus { font-size: 48rpx; color: #7C3AED; }
.upload-label { margin-top: 8rpx; font-size: 22rpx; color: #6D28D9; }
.replace-hint, .delete-btn { position: absolute; bottom: 10rpx; padding: 8rpx 12rpx; border-radius: 999rpx; font-size: 20rpx; color: #fff; background: rgba(31,41,55,.72); }
.replace-hint { left: 10rpx; }
.delete-btn { right: 10rpx; background: rgba(185,28,28,.82); }
.photo-hint { font-size: 23rpx; color: var(--mid-gray); margin-top: 16rpx; }
.feedback-textarea { width: 100%; min-height: 180rpx; background: var(--gray-50); border: 1rpx solid var(--gray-200); border-radius: 10rpx; padding: 16rpx; font-size: 26rpx; box-sizing: border-box; }
.retry-toggle { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.retry-opt { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; text-align: center; border: 1rpx solid var(--gray-200); border-radius: 12rpx; font-size: 25rpx; color: var(--text-muted); }
.retry-opt.active { background: var(--brand-blue); color: #fff; border-color: var(--brand-blue); }
.submit-bar { padding: 16rpx 0 32rpx; }
.btn-submit { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; background: var(--brand-blue); color: #fff; border: 0; border-radius: 14rpx; font-size: 30rpx; font-weight: 500; }
.btn-submit::after { border: 0; }
.btn-submit[disabled] { color: #fff; opacity: .65; }
