<nav-bar title="效果反馈" showBack="{{true}}"></nav-bar>
<!-- 回访反馈页（24h/30天/90天通用） -->
<view class="page">
  <view class="preview-banner" wx:if="{{isPreview}}">预览模式 · 这是用户看到的问卷页面</view>
  <view class="header">
    <view class="header-badge">{{modeLabel}}</view>
    <view class="header-title">感谢您的反馈</view>
    <view class="header-desc">您的反馈将帮助我们更好地优化体验效果</view>
  </view>

  <!-- 各部位改善满意度 -->
  <view class="section">
    <view class="section-title">各部位改善满意度</view>
    <view class="satisfaction-list">
      <view class="satisfy-item" wx:for="{{areas}}" wx:key="key">
        <view class="area-name">{{item.label}}</view>
        <view class="stars">
          <text
            wx:for="{{[1,2,3,4,5]}}"
            wx:for-item="star"
            wx:key="*this"
            class="star {{item.score >= star ? 'active' : ''}}"
            data-key="{{item.key}}"
            data-score="{{star}}"
            bindtap="onRate"
          >★</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作师评价（仅24h显示） -->
  <view class="section" wx:if="{{mode === '24h'}}">
    <view class="section-title">操作师评价</view>
    <view class="satisfaction-list">
      <view class="satisfy-item" wx:for="{{therapist}}" wx:key="key">
        <view class="area-name">{{item.label}}</view>
        <view class="stars">
          <text
            wx:for="{{[1,2,3,4,5]}}"
            wx:for-item="star"
            wx:key="*this"
            class="star {{item.score >= star ? 'active' : ''}}"
            data-key="{{item.key}}"
            data-score="{{star}}"
            bindtap="onTherapistRate"
          >★</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 体验满意度 -->
  <view class="section">
    <view class="section-title">体验满意度</view>
    <view class="satisfaction-list">
      <view class="satisfy-item" wx:for="{{experience}}" wx:key="key">
        <view class="area-name">{{item.label}}</view>
        <view class="stars">
          <text
            wx:for="{{[1,2,3,4,5]}}"
            wx:for-item="star"
            wx:key="*this"
            class="star {{item.score >= star ? 'active' : ''}}"
            data-key="{{item.key}}"
            data-score="{{star}}"
            bindtap="onExperienceRate"
          >★</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 拍照上传（24h不显示，操作师已上传；30天/90天显示） -->
  <view class="section" wx:if="{{mode !== '24h'}}">
    <view class="section-title">上传面部照片（可选）</view>
    <view class="photo-row">
      <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="photo-preview"></image>
        <view class="photo-del" data-idx="{{index}}" bindtap="delPhoto">×</view>
      </view>
      <view class="photo-add" wx:if="{{photos.length < 3}}" bindtap="addPhoto">
        <text class="add-icon">+</text>
        <text class="add-text">拍照</text>
      </view>
    </view>
    <view class="photo-hint">正脸照，自然光下拍摄效果最佳</view>
  </view>

  <!-- 文字反馈 -->
  <view class="section">
    <view class="section-title">其他反馈</view>
    <textarea class="feedback-textarea" placeholder="如您有其他建议或感受，请在此描述（可选）" value="{{remark}}" bindinput="onRemark" maxlength="500" />
  </view>

  <!-- 二次体验意愿（仅90天） -->
  <view class="section" wx:if="{{mode === '90'}}">
    <view class="section-title">二次体验意愿</view>
    <view class="retry-toggle">
      <view class="retry-opt {{retry === 'yes' ? 'active' : ''}}" data-v="yes" bindtap="onRetry">是，希望再次体验</view>
      <view class="retry-opt {{retry === 'no' ? 'active' : ''}}" data-v="no" bindtap="onRetry">否，暂不考虑</view>
    </view>
    <textarea
      class="feedback-textarea"
      placeholder="{{retry === 'yes' ? '请说明您希望再次体验的原因（可选）' : '请说明您暂不考虑的原因（可选）'}}"
      value="{{retryReason}}"
      bindinput="onRetryReason"
      maxlength="300"
      wx:if="{{retry}}"
    />
  </view>

  <view class="submit-bar">
    <view class="btn-submit" bindtap="submitFeedback">提交反馈</view>
  </view>

  <view class="bottom-safe"></view>
</view>
