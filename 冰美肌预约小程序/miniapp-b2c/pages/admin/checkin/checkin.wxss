.page {
  padding: 0 0 calc(30rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  min-height: 100vh;
}

/* 顶部导航 */
.ci-header {
  background: linear-gradient(135deg, #3B0764, #6D28D9);
  padding: 20rpx 32rpx 20rpx;
  color: white;
}
.ci-title { font-size: 40rpx; font-weight: 700; }
.ci-sub { font-size: 24rpx; color: var(--mid-gray); margin-top: 8rpx; display: block; }

/* 欢迎完成页 */
.ci-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--brand-blue) 0%, var(--brand-cyan) 40%, var(--brand-soft-blue) 100%);
  padding: 20rpx 20rpx;
  text-align: center;
}
.welcome-icon { font-size: 160rpx; margin-bottom: 32rpx; }
.welcome-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}
.welcome-sub {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}
.welcome-info {
  margin-top: 24rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
}
.wi-text { font-size: 24rpx; color: rgba(255,255,255,0.9); }

/* 卡片 */
.ci-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: var(--shadow-sm);
}
.ci-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

/* 知情同意书未签署卡片 */
.consent-required {
  text-align: center;
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
}
.cr-icon { font-size: 60rpx; display: block; margin-bottom: 12rpx; }
.cr-title { font-size: 30rpx; font-weight: 700; color: #92400E; margin-bottom: 8rpx; }
.cr-desc { font-size: 24rpx; color: #A16207; margin-bottom: 24rpx; line-height: 1.6; }
.cr-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #D97706, #F59E0B);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}
.cr-btn::after { border: none; }

.ci-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  gap: 16rpx;
}
.ci-label { font-size: 24rpx; color: var(--mid-gray); width: 100rpx; flex-shrink: 0; }
.ci-value { font-size: 26rpx; color: var(--text-primary); flex: 1; }

/* 空状态 */
.ci-empty { padding: 20rpx; text-align: center; }
.empty-text { font-size: 28rpx; color: var(--mid-gray); }
