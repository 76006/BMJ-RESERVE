.page {
  padding-bottom: max(140rpx, env(safe-area-inset-bottom) + 120rpx);
  min-height: 100vh;
  background: #f5f5f7;
}

.loading-wrap {
  padding: 60rpx 32rpx;
  text-align: center;
}
.loading-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ===== 列表区 ===== */
.section {
  margin: 24rpx 24rpx 0;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-header.fold {
  cursor: pointer;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}
.section-count {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}
.fold-arrow {
  margin-left: auto;
  font-size: 24rpx;
  color: #9CA3AF;
  transition: transform 0.2s;
}
.fold-arrow.open {
  transform: rotate(180deg);
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.staff-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.staff-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EDE9FE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.staff-avatar text {
  font-size: 32rpx;
  color: #3B0764;
  font-weight: 700;
}
.staff-avatar.super {
  background: #3B0764;
}
.staff-avatar.super text {
  color: white;
}
.staff-avatar.light {
  background: #E5E7EB;
}
.staff-avatar.light text {
  color: #6B7280;
}

.staff-info {
  flex: 1;
  min-width: 0;
}
.staff-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}
.staff-phone {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 400;
  margin-left: 8rpx;
}
.staff-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.role-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.role-tag.superadmin {
  background: #EDE9FE;
  color: #3B0764;
}
.role-tag.admin {
  background: #FEF3C7;
  color: #92400E;
}
.role-tag.staff {
  background: #E0F2FE;
  color: #0369A1;
}

.visitor-meta {
  font-size: 24rpx;
  color: #9CA3AF;
}

.staff-action {
  margin-left: 16rpx;
  flex-shrink: 0;
}
.btn-remove {
  font-size: 24rpx;
  color: #EF4444;
  padding: 10rpx 24rpx;
  border: 2rpx solid #FCA5A5;
  border-radius: 12rpx;
  line-height: 1.2;
}
.tag-self {
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 10rpx 20rpx;
}
.tag-added {
  font-size: 24rpx;
  color: #9CA3AF;
}
.btn-add {
  font-size: 24rpx;
  color: #3B0764;
  padding: 10rpx 24rpx;
  background: #EDE9FE;
  border-radius: 12rpx;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  padding: 24rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}

.visitor-tip {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

/* ===== 底部添加按钮 ===== */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 1rpx solid #E5E7EB;
  text-align: center;
  z-index: 10;
}
.bottom-btn text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  background: #3B0764;
  padding: 24rpx 0;
  border-radius: 12rpx;
}

/* ===== 弹窗 ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}
.modal-content {
  position: relative;
  z-index: 1;
  width: 80%;
  max-width: 560rpx;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.modal-input::placeholder {
  color: #9CA3AF;
}

.role-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.role-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid #E5E7EB;
  font-size: 28rpx;
  color: #6B7280;
  background: #F9FAFB;
}
.role-option.active {
  border-color: #3B0764;
  background: #EDE9FE;
  color: #3B0764;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}
.btn-cancel {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #6B7280;
  background: #F3F4F6;
}
.btn-confirm {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: white;
  background: #3B0764;
}
