.page { padding: 24rpx; min-height: 100vh; background: var(--gray-100); }

.test-header {
  text-align: center;
  padding: 32rpx 0 24rpx;
}
.test-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.test-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 560rpx;
  margin: 0 auto;
}

/* 卡片 */
.card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card.danger {
  border: 2rpx solid #FECACA;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 18rpx;
}
.card-body {
  margin-bottom: 18rpx;
}
.card-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

/* 按钮 */
.btn-full {
  width: 100%;
  height: 88rpx;
  background: #3B0764;
  color: #FFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  text-align: center;
  border: none;
  padding: 0;
  line-height: 88rpx;
}
.btn-full::after { border: none; }

.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: var(--gray-100);
  color: #3B0764;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  text-align: center;
  border: none;
  padding: 0;
  line-height: 88rpx;
}
.btn-secondary::after { border: none; }

.btn-danger {
  width: 100%;
  height: 88rpx;
  background: #FEF2F2;
  color: #EF4444;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  text-align: center;
  border: none;
  padding: 0;
  line-height: 88rpx;
}
.btn-danger::after { border: none; }

/* 分步网格 */
.step-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.step-btn {
  flex: 0 0 calc(50% - 8rpx);
  height: 80rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  text-align: center;
  border: none;
  padding: 0;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-btn::after { border: none; }

.status-pending { background: #EDE9FE; color: #3B0764; }
.status-confirmed { background: #D1FAE5; color: #059669; }
.status-visited { background: #FEF3C7; color: #D97706; }
.status-in_experience { background: #EDE9FE; color: #7C3AED; }
.status-completed { background: #F3F4F6; color: #6B7280; }
.status-cancelled { background: #FEE2E2; color: #DC2626; }

/* 快捷入口 */
.quick-links {
  display: flex;
  gap: 16rpx;
}
.link-btn {
  flex: 1;
  height: 80rpx;
  background: var(--gray-100);
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-sm);
  text-align: center;
  border: none;
  padding: 0;
  line-height: 80rpx;
}
.link-btn::after { border: none; }

/* 当前状态 */
.current-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cs-label { font-size: 26rpx; color: var(--text-muted); }
.cs-value { font-size: 28rpx; font-weight: 600; color: var(--text-brand); }
.cs-id { font-size: 24rpx; color: var(--text-light); margin-left: auto; }

/* 日志 */
.log-list {
  background: #F9FAFB;
  border-radius: var(--radius-sm);
  padding: 16rpx;
  max-height: 300rpx;
  overflow-y: auto;
}
.log-item {
  font-size: 22rpx;
  color: var(--text-muted);
  font-family: monospace;
  line-height: 1.8;
  padding: 2rpx 0;
}

.bottom-safe { height: 60rpx; }
