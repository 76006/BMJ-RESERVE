<nav-bar title="测试面板" showBack="{{true}}"></nav-bar>
<view class="page">
  <view class="test-header">
    <view class="test-title">🧪 模拟测试面板</view>
    <view class="test-desc">备案期间，绕过外部扫码/短信/手机号授权，直接测试完整业务流程。</view>
  </view>

  <!-- 一键完整流程 -->
  <view class="card">
    <view class="card-title">一键完整流程</view>
    <view class="card-body">
      <text class="card-desc">生成一条从"新预约"到"已体验"的完整测试记录（含知情同意书签署 + 体验参数），可直接跳转 detail 页查看。</text>
    </view>
    <button class="btn-full" bindtap="simulateFull">生成完整测试数据 → 查看 detail</button>
  </view>

  <!-- 分步生成 -->
  <view class="card">
    <view class="card-title">分步生成（各状态）</view>
    <view class="step-grid">
      <button class="step-btn status-pending" bindtap="simulateNew">新预约</button>
      <button class="step-btn status-confirmed" bindtap="simulateConfirmed">已预约</button>
      <button class="step-btn status-visited" bindtap="simulateVisited">已到店</button>
      <button class="step-btn status-in_experience" bindtap="simulateInExperience">体验中</button>
      <button class="step-btn status-completed" bindtap="simulateCompleted">已体验</button>
      <button class="step-btn status-cancelled" bindtap="simulateCancelled">已取消</button>
    </view>
  </view>

  <!-- 签到流程测试 -->
  <view class="card">
    <view class="card-title">签到流程测试</view>
    <view class="card-body">
      <text class="card-desc">模拟顾客扫门店码 → 自动匹配今日预约 → 签署知情同意书 → 完成签到。</text>
    </view>
    <button class="btn-secondary" bindtap="simulateGuestCheckin">进入签到流程（替代扫码）</button>
  </view>

  <!-- 导航快捷入口 -->
  <view class="card">
    <view class="card-title">快捷入口</view>
    <view class="quick-links">
      <button class="link-btn" bindtap="goToList">预约列表（后台）</button>
      <button class="link-btn" bindtap="goCheckinFlow">顾客签到页</button>
    </view>
  </view>

  <!-- 当前状态 -->
  <view class="card" wx:if="{{testBooking}}">
    <view class="card-title">最后操作</view>
    <view class="current-step">
      <text class="cs-label">状态: </text>
      <text class="cs-value">{{step === 'full' ? '完整流程' : step === 'pending_confirm' ? '新预约' : step === 'confirmed' ? '已预约' : step === 'visited' ? '已到店' : step === 'in_experience' ? '体验中' : step === 'completed' ? '已体验' : step === 'cancelled' ? '已取消' : ''}}</text>
      <text class="cs-id">ID: {{testBooking.id}}</text>
    </view>
  </view>

  <!-- 操作日志 -->
  <view class="card" wx:if="{{logs.length > 0}}">
    <view class="card-title">操作日志</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 清空 -->
  <view class="card danger">
    <view class="card-title">⚠️ 清空测试数据</view>
    <view class="card-body">
      <text class="card-desc">删除所有预约数据，不可恢复。</text>
    </view>
    <button class="btn-danger" bindtap="clearAll">清空所有数据</button>
  </view>

  <view class="bottom-safe"></view>
</view>
