.page {
  min-height: 100vh; background: var(--bg); padding: 0 0 calc(40rpx + env(safe-area-inset-bottom)); }
.action-bar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; }
.action-hint { font-size: 24rpx; color: #9CA3AF; }
.save-btn { font-size: 26rpx; color: #3B0764; background: #EDE9FE; padding: 10rpx 28rpx; border-radius: 8rpx; font-weight: 500; }

.hint { padding: 12rpx 24rpx; background: #F3F4F6; margin: 0 24rpx 12rpx; border-radius: 8rpx; }
.hint text { font-size: 24rpx; color: #6B7280; }

.date-list { height: calc(100vh - 320rpx); margin: 0 24rpx; background: #FFF; border-radius: 12rpx; }
.date-item { display: flex; align-items: center; padding: 16rpx 20rpx; border-bottom: 1rpx solid #F3F4F6; gap: 12rpx; }
.date-item.active { background: #F5F3FF; }
.date-left { flex-shrink: 0; width: 160rpx; }
.date-label { font-size: 26rpx; color: #1F2937; font-weight: 500; }

/* 时段状态标签 */
.date-slots { display: flex; gap: 6rpx; flex: 1; }
.mini-slot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 4rpx;
  border-radius: 6rpx;
  background: #D1FAE5;
  border: 1rpx solid #6EE7B7;
}
.mini-slot.closed {
  background: #F3F4F6;
  border-color: #D1D5DB;
}
.mini-slot-time { font-size: 20rpx; color: #374151; font-weight: 500; }
.mini-slot-tag { font-size: 18rpx; color: #065F46; }
.mini-slot.closed .mini-slot-tag { color: #9CA3AF; }
.date-arrow { font-size: 32rpx; color: #D1D5DB; flex-shrink: 0; }

/* 编辑面板 */
.edit-panel { margin: 16rpx 24rpx; background: #FFF; border-radius: 12rpx; padding: 24rpx; }
.panel-title { font-size: 28rpx; font-weight: 600; color: #1F2937; margin-bottom: 16rpx; }
.toggle-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.toggle-btn { flex:1; text-align: center; padding: 12rpx 0; border-radius: 8rpx; font-size: 26rpx; }
.toggle-btn.off { background: #FEE2E2; color: #DC2626; border: 1rpx solid #FCA5A5; }
.toggle-btn.on { background: #D1FAE5; color: #065F46; border: 1rpx solid #6EE7B7; }

.slot-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.slot-item { flex: 1 1 calc(33.33% - 8rpx); min-width: 180rpx; padding: 20rpx 12rpx; border-radius: 10rpx; border: 1rpx solid #6EE7B7; background: #F0FDF4; text-align: center; }
.slot-item.closed { background: #F3F4F6; border-color: #D1D5DB; }
.slot-time { display: block; font-size: 28rpx; color: #1F2937; font-weight: 600; }
.slot-tag { display: block; font-size: 22rpx; margin-top: 6rpx; color: #065F46; }
.slot-tag.open { color: #065F46; }
.slot-item.closed .slot-tag { color: #9CA3AF; }
