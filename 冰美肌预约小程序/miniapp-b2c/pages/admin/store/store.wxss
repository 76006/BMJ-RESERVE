.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #F6F7F8;
}

.intro-card, .form-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.05);
}

.intro-title { font-size: 32rpx; font-weight: 700; color: #3B0764; margin-bottom: 10rpx; }
.intro-text { font-size: 25rpx; color: #6B7280; line-height: 1.65; }
.field { margin-bottom: 28rpx; }
.label { font-size: 27rpx; font-weight: 600; color: #374151; margin-bottom: 12rpx; }
.label text { color: #DC2626; }

input, textarea {
  width: 100%;
  box-sizing: border-box;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
  color: #1F2937;
}

input { height: 88rpx; }
textarea { min-height: 140rpx; padding-top: 20rpx; padding-bottom: 20rpx; }

.save-btn {
  width: 460rpx;
  height: 92rpx;
  line-height: 92rpx;
  margin: 14rpx auto 0;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #3B0764, #6D28D9);
}

.save-btn[disabled] { opacity: 0.65; }
.save-hint, .updated { text-align: center; color: #9CA3AF; font-size: 23rpx; margin-top: 18rpx; }
.loading { text-align: center; color: #9CA3AF; font-size: 26rpx; padding: 100rpx 0; }
