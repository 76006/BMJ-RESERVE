.page {
  padding: 0 0 calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  min-height: 100vh;
}

.qr-header {
  background: linear-gradient(135deg, #3B0764, #6D28D9);
  padding: 20rpx 32rpx 20rpx;
  color: white;
}
.qr-back { font-size: 28rpx; color: rgba(255,255,255,0.85); margin-bottom: 16rpx; }
.qr-title { font-size: 40rpx; font-weight: 700; }
.qr-sub { font-size: 24rpx; color: var(--mid-gray); margin-top: 8rpx; line-height: 1.6; }

.info-card {
  margin: 24rpx;
  background: #FEF9C3;
  border: 1rpx solid #FDE047;
  border-radius: 16rpx;
  padding: 24rpx;
}
.info-card-title { font-size: 26rpx; font-weight: 700; color: #713F12; margin-bottom: 12rpx; }
.info-card-body { display: flex; flex-direction: column; gap: 8rpx; }
.p { font-size: 24rpx; color: #92400E; line-height: 1.6; }

.trainer-list { padding: 0 24rpx; }
.trainer-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}
.trainer-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.trainer-name { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.trainer-channel {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.trainer-channel.beauty { background: var(--green-bg); color: #065F46; }
.trainer-channel.medical { background: var(--brand-soft-blue); color: var(--brand-blue); }
.trainer-channel.admin { background: #FEE2E2; color: #991B1B; }

.divider {
  height: 16rpx;
  background: var(--bg);
  margin: 24rpx 0;
}
.trainer-id { font-size: 24rpx; color: var(--mid-gray); margin-bottom: 6rpx; }
.trainer-scene { font-size: 24rpx; color: var(--text-muted); word-break: break-all; margin-bottom: 16rpx; }
.trainer-actions { display: flex; gap: 16rpx; }
.copy-btn { display: inline-flex; align-items: center; justify-content: center; background: var(--brand-blue); color: white; font-size: 24rpx; font-weight: 500; border: none; border-radius: var(--radius-sm); padding: 10rpx 24rpx; line-height: 1.4; }
.del-btn { display: inline-flex; align-items: center; justify-content: center; background: var(--bg); color: var(--mid-gray); font-size: 24rpx; font-weight: 500; border: none; border-radius: var(--radius-sm); padding: 10rpx 24rpx; line-height: 1.4; }

.empty-trainer { text-align: center; padding: 24rpx; font-size: 26rpx; color: var(--mid-gray); }

.add-btn-wrap { padding: 0 24rpx; margin-top: 8rpx; }
.add-trainer-btn {
  width: 100%;
  background: white;
  color: var(--brand-blue);
  font-size: 28rpx;
  font-weight: 700;
  border: 2rpx solid var(--brand-light-blue);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.add-form {
  margin: 16rpx 24rpx 0;
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
}
.form-field { margin-bottom: 20rpx; }
.form-label { font-size: 24rpx; color: var(--text-muted); margin-bottom: 10rpx; }
.form-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--gray-50);
  border: 1rpx solid var(--gray-200);
  border-radius: 10rpx;
  font-size: 26rpx;
}
.form-picker {
  padding: 20rpx;
  background: var(--gray-50);
  border: 1rpx solid var(--gray-200);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}
.ph { color: var(--gray-300); }
.submit-btn {
  width: 100%;
  background: var(--brand-blue);
  color: white;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: var(--radius-md);
  padding: 24rpx;
  border: none;
  margin-top: 8rpx;
}

/* 门店签到码 */
.qrcode-card {
  margin: 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.qrcode-info {
  text-align: center;
}
.qrcode-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
}
.qrcode-status.ready { background: var(--green-bg); color: var(--green); }
.qrcode-status.pending { background: #FEF3C7; color: var(--amber-dark); }
.qrcode-img-area {
  width: 320rpx;
  text-align: center;
}
.qrcode-img {
  width: 100%;
  border-radius: 12rpx;
  box-shadow: var(--shadow-sm);
}
.qrcode-tip {
  display: block;
  font-size: 24rpx;
  color: var(--mid-gray);
  margin-top: 12rpx;
}
.qrcode-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--brand-blue);
  color: #FFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  text-align: center;
  border: none;
  padding: 0;
}
.qrcode-btn::after { border: none; }
.qrcode-btn[disabled] {
  background: #C4B5E0;
  color: #FFF;
}
.sim-checkin-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3B0764;
  color: #FFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  text-align: center;
  border: none;
  padding: 0;
}
.sim-checkin-btn::after { border: none; }
