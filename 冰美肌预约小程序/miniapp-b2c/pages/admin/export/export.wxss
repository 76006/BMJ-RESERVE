.page {
  padding: 0 0 40rpx;
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: max(40rpx, env(safe-area-inset-bottom));
}

/* 工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: white;
  border-bottom: 1rpx solid var(--light-gray);
}
.toolbar-info {
  font-size: 24rpx;
  color: var(--text-muted);
}
.toolbar-actions {
  display: flex;
  gap: 16rpx;
}
.toolbar-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
  color: #3B0764;
  background: #EDE9FE;
}
.btn-icon { font-size: 24rpx; }

/* 表格容器 */
.table-wrap {
  width: 100%;
  background: white;
  margin-top: 20rpx;
}

/* 表格 */
.table {
  display: table;
  border-collapse: collapse;
  min-width: 100%;
}
.thead, .tbody { display: table-row-group; }
.tr { display: table-row; }
.th, .td {
  display: table-cell;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  border-bottom: 1rpx solid #F3F4F6;
  vertical-align: middle;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.th {
  background: #3B0764;
  color: white;
  font-weight: 600;
  position: sticky;
  top: 0;
  z-index: 1;
}
.td {
  color: var(--text-secondary);
}
.tr:nth-child(even) .td {
  background: #FAFAFA;
}

/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 600;
}
.status-pending_confirm { background: var(--brand-soft-blue); color: var(--text-brand); }
.status-confirmed { background: var(--green-bg); color: var(--status-green); }
.status-visited { background: var(--gray-100); color: var(--text-secondary); }
.status-in_experience { background: var(--brand-soft-blue); color: var(--text-brand); }
.status-completed { background: var(--gray-100); color: var(--text-secondary); }
.status-cancelled { background: var(--red-bg); color: var(--red-dark); }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: var(--text-muted); }
