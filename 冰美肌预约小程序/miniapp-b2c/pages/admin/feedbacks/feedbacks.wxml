<nav-bar title="反馈管理" showBack="{{true}}"></nav-bar>
<view class="page">

  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-num">{{fb24Count}}</view>
      <view class="stat-label">24h回访</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{fb30Count}}</view>
      <view class="stat-label">30天回访</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{fb90Count}}</view>
      <view class="stat-label">90天回访</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{avgScore}}</view>
      <view class="stat-label">均满意度</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{pendingCount}}</view>
      <view class="stat-label">待回访</view>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'list' ? 'active' : ''}}" bindtap="switchTab" data-tab="list">回访记录</view>
    <view class="tab-item {{currentTab === 'template' ? 'active' : ''}}" bindtap="switchTab" data-tab="template">问卷编辑</view>
  </view>

  <block wx:if="{{currentTab === 'list'}}">
    <view class="filter-bar">
      <view class="filter-tag {{filterMode === 'all' ? 'active' : ''}}" bindtap="setFilter" data-mode="all">全部</view>
      <view class="filter-tag {{filterMode === '24h' ? 'active' : ''}}" bindtap="setFilter" data-mode="24h">24h</view>
      <view class="filter-tag {{filterMode === '30' ? 'active' : ''}}" bindtap="setFilter" data-mode="30">30天</view>
      <view class="filter-tag {{filterMode === '90' ? 'active' : ''}}" bindtap="setFilter" data-mode="90">90天</view>
    </view>

    <view class="fb-list" wx:if="{{filteredFeedbacks.length > 0}}">
      <view class="fb-card" wx:for="{{filteredFeedbacks}}" wx:key="*this" data-idx="{{index}}" bindtap="viewDetail">
        <view class="fb-card-header">
          <view class="fb-badge {{item.mode === '24h' ? 'badge-24h' : item.mode === '30' ? 'badge-30' : 'badge-90'}}">{{item.mode === '24h' ? '24h' : item.mode + '天'}}</view>
          <text class="fb-name">{{item.customerName}}</text>
          <text class="fb-overall">{{item._avgScore || '-'}}/5</text>
        </view>
        <view class="fb-card-body">
          <view class="fb-row">
            <text class="fb-label">提交时间</text>
            <text class="fb-value">{{item.submittedAt}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-text">暂无回访记录</text>
      <text class="empty-hint">客户到店体验后，回访问卷将显示在此处</text>
    </view>
  </block>

  <block wx:if="{{currentTab === 'template'}}">
    <view class="tmpl-section">
      <view class="tmpl-title">30天回访问卷（共12题）</view>
      <view class="tmpl-item" wx:for="{{tmpl30}}" wx:key="key" data-idx="{{index}}" data-type="30" bindtap="editQuestion">
        <text>第{{index + 1}}题：{{item.label}}</text>
      </view>
      <view class="preview-btn" bindtap="preview30">预览用户端30天问卷</view>
    </view>
    <view class="tmpl-section">
      <view class="tmpl-title">90天回访问卷（共13题）</view>
      <view class="tmpl-item" wx:for="{{tmpl90}}" wx:key="key" data-idx="{{index}}" data-type="90" bindtap="editQuestion">
        <text>第{{index + 1}}题：{{item.label}}</text>
      </view>
      <view class="preview-btn" bindtap="preview90">预览用户端90天问卷</view>
    </view>
    <view class="tmpl-section">
      <view class="tmpl-title">短信触发设置</view>
      <view class="sms-row">
        <text class="sms-label">30天短信提醒</text>
        <switch checked="{{sms30Enabled}}" bindchange="toggleSms30" color="#3B0764"/>
      </view>
      <view class="sms-row">
        <text class="sms-label">90天短信提醒</text>
        <switch checked="{{sms90Enabled}}" bindchange="toggleSms90" color="#3B0764"/>
      </view>
      <view class="sms-hint">短信将通过阿里云短信服务自动发送，需开通后生效</view>
    </view>
  </block>

  <view class="bottom-safe"></view>
</view>
