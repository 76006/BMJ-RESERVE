.page { background: var(--bg); min-height: 100vh; }
.stats-row { display: flex; padding: 20rpx 24rpx; gap: 16rpx; }
.stat-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 16rpx 8rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(91,127,165,0.08); }
.stat-num { font-size: 34rpx; font-weight: bold; color: var(--brand-blue); }
.stat-label { font-size: 22rpx; color: var(--mid-gray); margin-top: 4rpx; }

.tab-bar { display: flex; margin: 16rpx 24rpx; background: #fff; border-radius: 12rpx; overflow: hidden; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--text-muted); border-bottom: 4rpx solid transparent; }
.tab-item.active { color: var(--brand-blue); font-weight: bold; border-bottom-color: var(--brand-light-blue); }

.filter-bar { display: flex; padding: 16rpx 24rpx; gap: 16rpx; }
.filter-tag { padding: 8rpx 28rpx; border-radius: 32rpx; font-size: 24rpx; background: var(--gray-200); color: var(--text-muted); }
.filter-tag.active { background: var(--brand-blue); color: #fff; }

.fb-list { padding: 0 24rpx; }
.fb-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; padding: 24rpx; }
.fb-card-header { display: flex; align-items: center; gap: 12rpx; }
.fb-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
  color: #fff;
  background: var(--brand-blue);
}
.fb-badge.badge-24h { background: var(--brand-soft-blue); color: var(--text-brand); }
.fb-badge.badge-90 { background: var(--brand-light-blue); }
.fb-name { font-size: 30rpx; font-weight: bold; flex: 1; }
.fb-overall { font-size: 26rpx; color: var(--amber); }
.fb-card-body { margin-top: 16rpx; }
.fb-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; color: var(--text-muted); }
.fb-label { color: var(--mid-gray); }
.fb-value { text-align: right; max-width: 400rpx; }

.empty-state { text-align: center; padding: 25rpx 20rpx; }
.empty-text { display: block; font-size: 30rpx; color: var(--text-secondary); font-weight: bold; }
.empty-hint { display: block; font-size: 24rpx; color: var(--mid-gray); margin-top: 12rpx; }

.tmpl-section { margin: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.tmpl-title { font-size: 30rpx; font-weight: bold; color: var(--brand-blue); margin-bottom: 16rpx; }
.tmpl-item { padding: 18rpx 0; border-bottom: 1rpx solid var(--gray-100); font-size: 26rpx; color: var(--text-secondary); }

.preview-btn {
  display: flex; align-items: center; justify-content: center;
  margin-top: 20rpx;
  text-align: center;
  padding: 18rpx;
  background: var(--brand-blue);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.sms-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--gray-100); }
.sms-label { font-size: 26rpx; color: var(--text-secondary); }
.sms-hint { font-size: 24rpx; color: var(--mid-gray); margin-top: 12rpx; line-height: 1.5; }

.bottom-safe {
  height: env(safe-area-inset-bottom);
  height: constant(safe-area-inset-bottom);
}
