.page { background: var(--bg); min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.loading { padding: 120rpx 0; text-align: center; font-size: 28rpx; color: var(--mid-gray); }
.stats-row { display: flex; padding: 20rpx 24rpx; gap: 12rpx; }
.stat-card { flex: 1; min-width: 0; background: #fff; border-radius: 16rpx; padding: 16rpx 5rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(91,127,165,0.08); }
.stat-num { font-size: 34rpx; font-weight: bold; color: var(--brand-blue); }
.stat-label { font-size: 20rpx; color: var(--mid-gray); margin-top: 4rpx; white-space: nowrap; }
.tab-bar { display: flex; margin: 16rpx 24rpx; background: #fff; border-radius: 12rpx; overflow: hidden; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--text-muted); border-bottom: 4rpx solid transparent; }
.tab-item.active { color: var(--brand-blue); font-weight: bold; border-bottom-color: var(--brand-light-blue); }
.filter-bar { display: flex; padding: 16rpx 24rpx; gap: 16rpx; }
.filter-tag { padding: 8rpx 26rpx; border-radius: 32rpx; font-size: 24rpx; background: var(--gray-200); color: var(--text-muted); }
.filter-tag.active { background: var(--brand-blue); color: #fff; }
.fb-list { padding: 0 24rpx; }
.fb-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; padding: 24rpx; }
.fb-card-header { display: flex; align-items: center; gap: 12rpx; }
.fb-badge { display: inline-flex; align-items: center; justify-content: center; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: var(--radius-full); font-weight: 600; color: #fff; background: var(--brand-blue); }
.fb-badge.badge-24h { background: var(--brand-soft-blue); color: var(--text-brand); }
.fb-badge.badge-90 { background: var(--brand-light-blue); }
.fb-name { font-size: 30rpx; font-weight: bold; flex: 1; }
.fb-overall { font-size: 26rpx; color: var(--amber); }
.fb-card-body { margin-top: 16rpx; }
.fb-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 9rpx 0; font-size: 24rpx; color: var(--text-muted); }
.fb-label { color: var(--mid-gray); flex-shrink: 0; }
.fb-value { text-align: right; }
.reminder-text { max-width: 470rpx; }
.fb-note { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 10rpx; background: #FFFBEB; color: #92400E; font-size: 23rpx; line-height: 1.55; }
.fb-note.customer { background: #F5F3FF; color: #5B21B6; }
.empty-state { text-align: center; padding: 100rpx 20rpx; }
.empty-text { display: block; font-size: 30rpx; color: var(--text-secondary); font-weight: bold; }
.empty-hint { display: block; font-size: 24rpx; color: var(--mid-gray); margin-top: 12rpx; }
.template-tip { display: flex; flex-direction: column; gap: 8rpx; margin: 20rpx 24rpx 0; padding: 18rpx 20rpx; background: #EDE9FE; border-radius: 12rpx; color: #5B21B6; font-size: 23rpx; line-height: 1.5; }
.tmpl-section { margin: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.tmpl-title { font-size: 30rpx; font-weight: bold; color: var(--brand-blue); margin-bottom: 16rpx; }
.tmpl-item { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--gray-100); font-size: 26rpx; color: var(--text-secondary); }
.tmpl-index { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #F3F4F6; color: #6B7280; font-size: 21rpx; flex-shrink: 0; }
.tmpl-label { flex: 1; line-height: 1.5; }
.tmpl-edit { color: #6D28D9; font-size: 22rpx; }
.preview-btn { display: flex; align-items: center; justify-content: center; margin-top: 20rpx; text-align: center; padding: 18rpx; background: var(--brand-blue); color: #fff; border-radius: var(--radius-md); font-size: 28rpx; font-weight: 600; }
.reminder-section { margin-bottom: 0; }
.reminder-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--gray-100); font-size: 25rpx; }
.enabled { color: #059669; font-weight: 600; }
.sms-hint { font-size: 23rpx; color: var(--mid-gray); margin-top: 14rpx; line-height: 1.55; }
