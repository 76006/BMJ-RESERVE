/* ===== HERO 全屏 ===== */
.hero {
  position: relative;
  height: calc(100vh - 240rpx);
  min-height: 900rpx;
  overflow: hidden;
  background: #d0d0d5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.hero-status {
  width: 100%;
  flex-shrink: 0;
}
.hero-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 32rpx 20rpx;
  color: #EDE9FE;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 16rpx rgba(0,0,0,0.3);
}
.hero-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.02) 40%, rgba(0,0,0,0.35) 75%, rgba(0,0,0,0.65) 100%);
  pointer-events: none;
}
.hero-text {
  position: relative;
  z-index: 5;
  text-align: center;
  margin-top: 120rpx;
}
.hero-title-1 {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 16rpx;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 30rpx rgba(0,0,0,0.25);
}
.hero-title-2 {
  display: block;
  font-size: 34rpx;
  font-weight: 300;
  color: #fff;
  letter-spacing: 20rpx;
  text-shadow: 0 2rpx 16rpx rgba(0,0,0,0.2);
}
.hero-scroll {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #EDE9FE;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  font-weight: 700;
  animation: bounce 2s ease-in-out infinite;
}
.hero-arrow {
  width: 0;
  height: 0;
  margin-top: 10rpx;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 16rpx solid #EDE9FE;
}
@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(16rpx); }
}

/* ===== 首屏下方3模块 ===== */
.feature-section {
  padding: 16rpx 32rpx;
  background: #fff;
}
.feature-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}
.feature-card {
  flex: 1;
  background: var(--gray-100);
  border-radius: 24rpx;
  padding: 20rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.feature-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  background: var(--brand-soft-blue);
  color: var(--text-secondary);
}
.feature-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* ===== Section label ===== */
.sec-label {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: left;
  padding: 0;
  margin-bottom: 24rpx;
}
/* ===== 为什么选择冰美肌 —— 2×2 卡片网格 ===== */
.why-section {
  background: #d0d0d5;
  padding: 48rpx 32rpx;
}
.why-section .sec-label {
  color: #1F2937;
  margin-bottom: 32rpx;
  letter-spacing: 6rpx;
}
.why-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.why-card {
  background: #fff;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16rpx;
  box-sizing: border-box;
}
.why-card-icon {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #EDE9FE;
  display: flex;
  align-items: center;
  justify-content: center;
}
.why-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 2rpx;
}
.why-card-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* ===== Booking Form Block ===== */
.book-block {
  background: #fff;
  padding: 24rpx 32rpx 32rpx;
}

.form-field {
  margin-bottom: 18rpx;
}
.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.form-field input {
  width: 100%;
  height: 88rpx;
  background: var(--gray-50);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.ph { color: var(--gray-300); }

.form-row {
  display: flex;
  gap: 20rpx;
}
.form-row .half {
  flex: 1;
  margin-bottom: 32rpx;
}
.picker-value {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--gray-50);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}
.picker-value.placeholder { color: var(--gray-300); }

.slot-status-item.past {
  opacity: 0.55;
  background: var(--gray-100);
  color: var(--gray-500);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: var(--gray-50);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.required { color: var(--red); font-weight: 400; }
.field-label .hint { color: var(--text-muted); font-weight: 400; font-size: 24rpx; margin-left: 8rpx; }

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-top: 24rpx;
  padding: 0;
  line-height: normal;
}
.submit-btn::after { border: none; }

/* 隐私协议 */
.privacy-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 0 4rpx;
}
.privacy-check {
  display: flex;
  align-items: center;
}
.privacy-row .checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--gray-300);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s;
}
.privacy-row .checkbox.checked {
  background: var(--brand-blue);
  border-color: var(--brand-blue);
}
.privacy-text {
  font-size: 24rpx;
  color: var(--text-muted);
}
.privacy-link {
  font-size: 24rpx;
  color: var(--brand-blue);
  text-decoration: underline;
}

/* 渠道来源徽章 */
.channel-badge-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.channel-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-blue);
  background: var(--brand-soft-blue);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}
.trainer-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--green-dark);
  background: var(--green-bg);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}

.page-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
  background: #fff;
}

/* ===== 微信手机号授权 ===== */
/* ===== 微信授权 — 全宽主按钮，权重最高 ===== */
button.method-auth-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100% !important;
  height: 100rpx;
  margin: 0;
  padding: 0 24rpx;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx !important;
  border: none;
  letter-spacing: 2rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
}
button.method-auth-btn::after {
  border: none;
  border-radius: 14rpx !important;
}
button.method-auth-btn .method-auth-icon,
button.method-auth-btn .method-auth-main,
button.method-auth-btn .method-auth-hint {
  white-space: nowrap;
  flex-shrink: 0;
}
.method-auth-icon {
  font-size: 32rpx;
}
.method-auth-main {
  font-size: inherit;
  font-weight: inherit;
}
.method-auth-hint {
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.9;
  margin-left: 8rpx;
}

/* 分隔 or */
.phone-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 16rpx 0;
  position: relative;
}
.phone-divider::before,
.phone-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--gray-200);
}
.phone-divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.phone-verified {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: var(--gray-50);
  border-radius: 14rpx;
  padding: 0 24rpx;
}
.phone-verified .phone-number {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}
.phone-verified .phone-check {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
}

/* ===== 时段状态指示（三态） ===== */
.slot-status-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 4rpx 0 8rpx;
}
.slot-status-item {
  flex: 1 1 30%;
  min-width: 180rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm, 12rpx);
  background: #f5f7fa;
  border: 1rpx solid #e6e9ef;
}
.slot-status-time {
  font-size: 26rpx;
  color: #333;
}
.slot-status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
/* 可约 */
.slot-status-item.free {
  background: #eafaf0;
  border-color: #b7ebc8;
}
.slot-status-item.free .slot-status-tag {
  color: #1a7f37;
  background: #d6f5e1;
}
/* 已约满 */
.slot-status-item.booked {
  background: #fff1f0;
  border-color: #ffccc7;
}
.slot-status-item.booked .slot-status-tag {
  color: #cf1322;
  background: #ffd9d6;
}
/* 未开放 */
.slot-status-item.closed {
  background: #f0f0f0;
  border-color: #d9d9d9;
  opacity: 0.7;
}
.slot-status-item.closed .slot-status-time {
  color: #999;
}
.slot-status-item.closed .slot-status-tag {
  color: #8c8c8c;
  background: #e0e0e0;
}

