/* ===== Design Tokens ===== */
page {
  /* Brand */
  --brand-blue: #3B0764;
  --brand-light-blue: #6D28D9;
  --brand-cyan: #6D28D9;
  --brand-soft-blue: #EDE9FE;
  --gradient: linear-gradient(135deg, #3B0764, #6D28D9);

  /* Neutral */
  --white: #FFFFFF;
  --bg: #F6F7F8;
  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --light-gray: #F0F0F0;
  --gray-300: #D1D5DB;
  --mid-gray: #9CA3AF;
  --gray-500: #6B7280;

  /* Text */
  --text-primary: #1F2937;
  --text-secondary: #374151;
  --text-muted: #6B7280;
  --text-light: #9CA3AF;
  --text-brand: #3B0764;
  --text-on-brand: #FFFFFF;

  /* Semantic */
  --red: #EF4444;
  --red-dark: #DC2626;
  --red-bg: #FEF2F2;
  --green: #10B981;
  --green-dark: #059669;
  --green-bg: #D1FAE5;
  --status-green: #065F46;
  --amber: #F59E0B;
  --amber-dark: #D97706;

  /* Spacing & Shape */
  --shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.04);
  --shadow-lg: 0 8rpx 40rpx rgba(0,0,0,0.1);
  --shadow-brand: 0 16rpx 40rpx rgba(59,7,100,0.25);
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-full: 9999rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;

  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  background: var(--bg);
  color: var(--text-secondary);
  font-size: 30rpx;
}

/* ===== Section ===== */
.section {
  padding: 24rpx 32rpx;
}
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
  line-height: 1.3;
}
.section-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: var(--space-lg);
  line-height: 1.5;
}

/* ===== Tag ===== */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--brand-blue);
  background: var(--brand-soft-blue);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-sm);
}

/* ===== Button ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: var(--gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: var(--shadow-brand);
}
.btn-primary::after {
  border: none;
}

/* ===== Tag Standards ===== */
.tag-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5rpx 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: var(--radius-sm);
}
.tag-md {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: var(--radius-full);
}
.tag-lg {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--radius-full);
}

/* ===== Button Standards ===== */
.btn-xl {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 96rpx;
  font-size: 32rpx; font-weight: 600;
  border-radius: 16rpx;
  border: none;
}
.btn-lg {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 88rpx;
  font-size: 32rpx; font-weight: 600;
  border-radius: 16rpx;
  border: none;
}
.btn-md {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 88rpx;
  font-size: 28rpx; font-weight: 500;
  border-radius: var(--radius-md);
  border: none;
}
.btn-sm {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 16rpx 32rpx;
  font-size: 26rpx; font-weight: 600;
  border-radius: var(--radius-sm);
  border: none;
}
.btn-xs {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 10rpx 24rpx;
  font-size: 24rpx; font-weight: 500;
  border-radius: var(--radius-sm);
  border: none;
}
.card {
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
}
